# CompanionAI — configurazione opzionale via variabili d'ambiente.
#
# Non e' obbligatorio: al primo avvio la chat chiede provider, modello e chiave,
# e li salva in ~/.desktop-companion/config.json. Questo file serve se preferisci
# tenere le chiavi fuori dalla configurazione dell'app.
#
# Copia in .env e togli il commento alle righe che ti servono.
# Il file .env e' escluso da git: non committarlo mai.

# OPENROUTER_API_KEY=sk-or-...   # default del progetto, ha modelli gratuiti
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=...

# Ollama gira in locale e non richiede chiavi.
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434

# Dove scrivere il pacchetto prodotto da "npm run build".
# Se non impostata, viene usata una cartella sotto la temp di sistema:
# le cartelle sincronizzate (OneDrive, Dropbox) fanno fallire rcedit.
# COMPANION_BUILD_OUT=C:\builds\companionai
